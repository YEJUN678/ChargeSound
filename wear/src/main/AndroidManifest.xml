<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      2026-10-24: 워치 전용 선언을 제거했습니다.
        <uses-feature android:name="android.hardware.type.watch" android:required="true" />
        <meta-data android:name="com.google.android.wearable.standalone" android:value="true" />

      이유: Galaxy Store 는 이 선언이 있으면 "Android Watch 애플리케이션" 으로 분류하고
      중국 외 국가 판매를 막습니다. 선언을 빼면 일반 앱으로 등록되어 국내 판매가 가능합니다.

      부작용(중요):
      - 스토어가 이 APK 를 워치 기기에 내려주지 않습니다. 일반 휴대폰 앱으로 취급됩니다.
      - 패키지명(com.chargesound.app)이 휴대폰 앱과 같아서, 같은 기기에 둘 다 설치할 수
        없습니다 (같은 서명키라 "업데이트" 로 취급되고 versionCode 가 낮으면 거부됩니다).
      Data Layer 동기화는 패키지명이 같아야 동작하므로 이 이름은 유지합니다.
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChargeSoundWear">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@style/Theme.ChargeSoundWear">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
