<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_size_config_title"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <RadioGroup
        android:id="@+id/size_radio_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center">

        <RadioButton
            android:id="@+id/rb_compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_size_compact"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="12dp" />

        <RadioButton
            android:id="@+id/rb_standard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_size_standard"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="12dp" />

        <RadioButton
            android:id="@+id/rb_detailed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_size_detailed"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:padding="12dp" />
    </RadioGroup>

</LinearLayout>