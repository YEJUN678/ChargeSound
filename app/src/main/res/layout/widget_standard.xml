<?xml version="1.0" encoding="utf-8"?>
<!-- 4×1 표준: 배터리% + 상태 + 충전기 + 진행바 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 상단: 배터리% + 충전 상태 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_level"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_level_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_status_charging_short"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 중간: 충전기 + 온도 -->
    <TextView
        android:id="@+id/widget_plug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_plug_placeholder"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <!-- 하단: 진행바 -->
    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="85"
        android:progressTint="#00E5FF"
        android:progressBackgroundTint="#1E293B" />

</LinearLayout>