<?xml version="1.0" encoding="utf-8"?>
<!--
  위젯 배경 (다크).
  단색 대신 위→아래 그라디언트를 써서 평면으로 보이지 않게 합니다.
  테두리는 1dp 반투명 슬레이트 — 홈 화면 배경이 밝아도 경계가 유지됩니다.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#05080E"
        android:startColor="#101B2E" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#22303F" />
</shape>
