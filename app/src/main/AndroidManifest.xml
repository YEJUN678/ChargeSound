<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Google Mobile Ads: targetSdk 33+ requires the advertising ID permission -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!--
      SYSTEM_ALERT_WINDOW: Android 10+ blocks background activity launches (BAL).
      A charging screen that pops over other apps is the classic exception that
      requires this special permission. Users grant it manually in Settings, and the
      app degrades to a notification if it is not granted.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".ChargeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- 스플래시/온보딩 진입점 — LAUNCHER 는 여기만 둡니다. -->
        <activity
            android:name=".ui.LaunchActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Splash"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 첫 실행 온보딩 (권한 + 자동실행) -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize">
            <!-- LAUNCHER 없음 — LaunchActivity 가 분기합니다 -->

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 런처 롱프레스 바로가기 실행기 -->
        <receiver
            android:name=".service.ShortcutActionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.chargesound.app.action.TOGGLE_SERVICE" />
                <action android:name="com.chargesound.app.action.PREVIEW_ANIMATION" />
                <action android:name="com.chargesound.app.action.OPEN_ALARM" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ui.ChargingAnimationActivity"
            android:exported="false"
            android:label="Charging Effect"
            android:theme="@style/Theme.MyApplication"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop"
            android:taskAffinity="" />

        <service
            android:name=".service.ChargingMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Charging detector service that plays custom sound and animation on power connect" />
        </service>

        <!-- 빠른 설정 타일 (Android 7.0+) -->
        <service
            android:name=".service.ChargingTileService"
            android:enabled="@bool/tile_enabled"
            android:exported="true"
            android:icon="@drawable/charge_sound_icon_1791457205401"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 홈 화면 위젯 (Glance 없이 RemoteViews, 3 크기 지원) -->
        <receiver
            android:name=".widget.ChargingWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.chargesound.app.widget.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_charging_info" />
        </receiver>

        <!-- 위젯 크기 설정 액티비티 -->
        <activity
            android:name=".widget.WidgetSizeConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication" />

        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".service.ChargingBroadcastReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>


    <!-- 충전 알림 액션 (스누즈 · 해제). 알림 버튼이 이 리시버를 호출합니다. -->
    <receiver
        android:name=".service.AlarmActionReceiver"
        android:exported="false" />
    </application>

</manifest>
